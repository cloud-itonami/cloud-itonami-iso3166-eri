(ns marketentry.facts-test
  (:require [kotoba.test :refer [deftest is testing]]
            [marketentry.facts :as facts]))

(deftest eri-has-spec-basis
  (let [sb (facts/spec-basis "ERI")]
    (is (some? sb))
    (is (string? (:provenance sb)))
    (is (seq (:required-evidence sb)))
    (is (some? (facts/corporate-number-spec-basis "ERI")))
    (is (some? (facts/mining-procurement-spec-basis "ERI")))))

(deftest eri-rep-spec-basis-is-honestly-absent
  (testing "no representative/director exclusion-extension provision could be found for Eritrea -- deliberately not claimed"
    (is (nil? (facts/rep-spec-basis "ERI")))))

(deftest unknown-jurisdiction-has-no-spec-basis
  (is (nil? (facts/spec-basis "ATL")))
  (is (nil? (facts/spec-basis "ZZZ"))))

(deftest required-evidence-satisfied
  (let [sb (facts/spec-basis "ERI")
        all (:required-evidence sb)]
    (is (true? (facts/required-evidence-satisfied? "ERI" all)))
    (is (not (facts/required-evidence-satisfied? "ERI" (take 1 all))))
    (is (nil? (facts/required-evidence-satisfied? "ATL" all)))))

(deftest coverage-is-honest
  (let [c (facts/coverage ["ERI" "USA" "ATL"])]
    (is (= 3 (:requested c)))
    (is (= 2 (:covered c)))
    (is (= ["ATL"] (:missing-jurisdictions c)))))

(deftest mining-procurement-spec-basis-criteria
  (let [mp (facts/mining-procurement-spec-basis "ERI")]
    (is (= 3 (get-in mp [:mining-procurement-criteria :min-suppliers])))))
